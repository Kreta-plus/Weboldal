<mxfile host="app.diagrams.net" agent="ZsírKréta dokumentáció" version="24.7.17"><diagram id="1. Áttek" name="1. Áttekintés"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1. 1" value="&lt;b&gt;ZsírKréta – a teljes rendszer egy képen&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="1. 2" value="Két Flask-alkalmazás egy repóban: a diák verzió (zsirkreta, 3000-es port) és a tanári verzió (tanar/kreta_tanar, 3100-as port). Mindkettő a felhasználó saját KRÉTA-fiókjával dolgozik, az adatokat SQLite-ban tárolja, és vanilla JS felületet szolgál ki ugyanarról a szerverről." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell><mxCell id="1. 3" value="&lt;b&gt;👩‍🎓 Diák&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;böngésző (gép / telefon)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="230" height="70" as="geometry"/></mxCell><mxCell id="1. 4" value="&lt;b&gt;🧑‍🏫 Tanár&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;böngésző, csak a saját gépén&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="230" height="70" as="geometry"/></mxCell><mxCell id="1. 5" value="&lt;b&gt;🌐 Nyitóoldal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;landerpage/ (statikus HTML)&lt;br&gt;jegyszámoló demó, „Kipróbálom”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="1. 6" value="Frontend (public/, vanilla JS, ES modulok)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFF4B8;swimlaneFillColor=#FFFFFF;strokeColor=#C9A800;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="380" height="460" as="geometry"/></mxCell><mxCell id="1. 7" value="&lt;b&gt;Diák felület – public/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;index.html + css/app.css („Kiemelő az íróasztalon”)&lt;br&gt;main.js: hash-routing (#nézet), keret, frissítés&lt;br&gt;api.js: fetch + X-KP fejléc (CSRF)&lt;br&gt;views/: kezdőlap, jegyek, statisztika, órarend,&lt;br&gt;házi, hiányzás, tervező, táska, nevek, …&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 6"><mxGeometry x="20" y="50" width="340" height="170" as="geometry"/></mxCell><mxCell id="1. 8" value="&lt;b&gt;Tanári felület – tanar/public/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;main.js: menü, frissítés, hiba/ötlet gomb&lt;br&gt;ops.js: megerősítő ablak minden íráshoz&lt;br&gt;views/: kezdőlap, órarend → óra oldala,&lt;br&gt;mulasztás, haladási napló, jegynapló,&lt;br&gt;házi, számonkérés, osztályok, műveletnapló&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 6"><mxGeometry x="20" y="240" width="340" height="190" as="geometry"/></mxCell><mxCell id="1. 9" value="Backend (Python 3.14, Flask; gunicorn a konténerben)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="520" height="560" as="geometry"/></mxCell><mxCell id="1. 10" value="&lt;b&gt;zsirkreta/ – diák API (3000)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;/api/auth: belépés (KRÉTA-oldal, jelszó, e-mail), teszt fiók&lt;br&gt;/api/data: bundle + egyes adatok, gyorsítótárral&lt;br&gt;/api/prefs: beállítások · /api/site: közlemény, admin&lt;br&gt;/api/feedback: hiba / ötlet / üzenet · /api/contact&lt;br&gt;kreta.py: OAuth2+PKCE, token, udvarias lekérés&lt;br&gt;demo.py: kitalált diák · monitoring.py: GlitchTip&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 9"><mxGeometry x="20" y="50" width="480" height="220" as="geometry"/></mxCell><mxCell id="1. 11" value="&lt;b&gt;tanar/kreta_tanar/ – tanári API (3100)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;/api/auth: KRÉTA-oldali / jelszavas belépés, teszt fiók&lt;br&gt;/api/t: áttekintés, órák, csoport, osztály, diák, házi, …&lt;br&gt;/api/ops: preview → commit (írás a KRÉTA-ba)&lt;br&gt;ops.py: ellenőrzés, előnézet, egyszeri token, napló&lt;br&gt;providers/: DemoProvider (teszt iskola) | KretaProvider&lt;br&gt;kreta_client.py: token, gyorsítótár, szünetek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 9"><mxGeometry x="20" y="290" width="480" height="240" as="geometry"/></mxCell><mxCell id="1. 12" value="Tárolás (SQLite, a /data kötetben)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D4F7E8;swimlaneFillColor=#FFFFFF;strokeColor=#17A06A;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="820" y="720" width="520" height="230" as="geometry"/></mxCell><mxCell id="1. 13" value="&lt;b&gt;data/zsirkreta.db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;users (titkosított tokenek)&lt;br&gt;sessions · cache · prefs&lt;br&gt;attempts · site&lt;br&gt;+ secret.key (Fernet)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 12"><mxGeometry x="20" y="50" width="230" height="160" as="geometry"/></mxCell><mxCell id="1. 14" value="&lt;b&gt;tanar/data/kreta_tanar.db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;users · sessions · prefs&lt;br&gt;cache · attempts&lt;br&gt;demo_state · pending_ops&lt;br&gt;audit (műveletnapló)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 12"><mxGeometry x="270" y="50" width="230" height="160" as="geometry"/></mxCell><mxCell id="1. 15" value="Külső szolgáltatások" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFD6E8;swimlaneFillColor=#FFFFFF;strokeColor=#D63A80;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="430" height="830" as="geometry"/></mxCell><mxCell id="1. 16" value="&lt;b&gt;KRÉTA IdP – idp.e-kreta.hu&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;/connect/authorize (PKCE, belépőoldal)&lt;br&gt;/connect/token (kód, refresh)&lt;br&gt;diák: kreta-ellenorzo-student-mobile-ios&lt;br&gt;tanár: kreta-naplo-mobile-ios&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 15"><mxGeometry x="20" y="50" width="390" height="120" as="geometry"/></mxCell><mxCell id="1. 17" value="&lt;b&gt;KRÉTA Ellenőrző API (diák)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;{iskola}.e-kreta.hu … Sajat/…&lt;br&gt;TanuloAdatlap, Ertekelesek, OrarendElemek,&lt;br&gt;Mulasztasok, HaziFeladatok, Számonkérések, Feljegyzések&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 15"><mxGeometry x="20" y="190" width="390" height="120" as="geometry"/></mxCell><mxCell id="1. 18" value="&lt;b&gt;KRÉTA Napló API V3 (tanár)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;{iskola}.e-kreta.hu/naplo/V3/&lt;br&gt;olvas: Tanar/Profil, Orarend, OsztalyCsoport/…, Jelenlet&lt;br&gt;ír: Orarend/OraNaplozas, HaziFeladat,&lt;br&gt;BejelentettSzamonkeres, OsztalyCsoport/Ertekeles&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 15"><mxGeometry x="20" y="330" width="390" height="150" as="geometry"/></mxCell><mxCell id="1. 19" value="&lt;b&gt;GlitchTip (app.glitchtip.com)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;diák projekt (29549) · „Tanári” projekt (29663)&lt;br&gt;szerverhibák + hiba/ötlet bejelentések&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 15"><mxGeometry x="20" y="500" width="390" height="110" as="geometry"/></mxCell><mxCell id="1. 20" value="&lt;b&gt;Discord&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;webhook: értesítés a bejelentésekről&lt;br&gt;meghívó a Kapcsolatok oldalon (diák)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 15"><mxGeometry x="20" y="630" width="390" height="90" as="geometry"/></mxCell><mxCell id="1. 21" value="A KRÉTA-végpontok nem hivatalos, nyílt forráskódú kliensekből (Refilc/Firka, kreta.js, Coware Napló+) származnak." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1. 15"><mxGeometry x="20" y="735" width="390" height="80" as="geometry"/></mxCell><mxCell id="1. 22" value="Futtatás" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFE3C4;swimlaneFillColor=#FFFFFF;strokeColor=#D9791C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="680" height="230" as="geometry"/></mxCell><mxCell id="1. 23" value="&lt;b&gt;Docker (egy Dockerfile, két célpont)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;--target diak → zsirkreta (3000)&lt;br&gt;--target tanar → zsirkreta-tanar (3100)&lt;br&gt;python:3.14-slim, gunicorn 1 worker × 8 szál&lt;br&gt;nem root (app), HEALTHCHECK /api/health&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 22"><mxGeometry x="20" y="50" width="310" height="160" as="geometry"/></mxCell><mxCell id="1. 24" value="&lt;b&gt;Helyi fejlesztés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;uv run run.py (diák, 3000)&lt;br&gt;uv run tanar/run.py (tanár, 3100)&lt;br&gt;docker compose up -d · --profile tanar&lt;br&gt;diák: HTTPS-es proxy mögé; tanár: csak 127.0.0.1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 22"><mxGeometry x="350" y="50" width="310" height="160" as="geometry"/></mxCell><mxCell id="1. 25" value="megnyitja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 3" target="1. 7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 26" value="„Belépek” / „Kipróbálom”" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 5" target="1. 7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 27" value="megnyitja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 4" target="1. 8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 28" value="fetch /api/… (JSON, kt/kp_sid süti, X-KP: 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 7" target="1. 10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 29" value="fetch /api/… (JSON, kt_sid süti, X-KP: 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 8" target="1. 11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 10" target="1. 13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 11" target="1. 14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 32" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 10" target="1. 16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 33" value="GET (gyorsítótárral)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 10" target="1. 17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 34" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 11" target="1. 16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 35" value="GET + írás (jóváhagyás után)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 11" target="1. 18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 10" target="1. 19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 37" value="Sentry SDK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 11" target="1. 19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 38" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.97;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1. 10" target="1. 20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 39" value="Jelmagyarázat" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#F2EEE9;swimlaneFillColor=#FFFFFF;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=13;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="1790" height="110" as="geometry"/></mxCell><mxCell id="1. 40" value="Frontend (böngésző)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 39"><mxGeometry x="20" y="50" width="270" height="44" as="geometry"/></mxCell><mxCell id="1. 41" value="Backend (Flask)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 39"><mxGeometry x="320" y="50" width="270" height="44" as="geometry"/></mxCell><mxCell id="1. 42" value="Tárolás (SQLite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 39"><mxGeometry x="620" y="50" width="270" height="44" as="geometry"/></mxCell><mxCell id="1. 43" value="Külső szolgáltatás" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 39"><mxGeometry x="920" y="50" width="270" height="44" as="geometry"/></mxCell><mxCell id="1. 44" value="Futtatás / folyamat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1. 39"><mxGeometry x="1220" y="50" width="270" height="44" as="geometry"/></mxCell><mxCell id="1. 45" value="folytonos nyíl: kérés · szaggatott: naplózás, tárolás, értesítés" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1. 39"><mxGeometry x="1530" y="46" width="250" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2. Diák " name="2. Diák backend"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2. 1" value="&lt;b&gt;Diák backend – zsirkreta/ (Flask, 3000)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="2. 2" value="create_app(): monitoring.init() → Flask → blueprintek → before_request: CSRF (X-KP fejléc) → after_request: biztonsági fejlécek (CSP, nosniff, DENY). KP_TRUST_PROXY esetén ProxyFix. A felület a public/ mappából jön (/), a /api/health a konténer egészség-ellenőrzése." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell><mxCell id="2. 3" value="Blueprintek (HTTP API)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1000" height="820" as="geometry"/></mxCell><mxCell id="2. 4" value="&lt;b&gt;/api/auth – auth.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;POST /login – jelszavas KRÉTA-belépés (szkriptelt PKCE, tartalék: password grant)&lt;br&gt;GET /link/start → POST /link/finish – belépés a KRÉTA oldalán, a cím beillesztésével&lt;br&gt;POST /demo – teszt fiók · GET /me – ki van belépve&lt;br&gt;POST /email, /email/login, /email/remove – e-mailes belépés (admin / fejlesztő)&lt;br&gt;POST /logout, /logout-all · GET /sessions · POST /account/delete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 3"><mxGeometry x="20" y="50" width="960" height="200" as="geometry"/></mxCell><mxCell id="2. 5" value="&lt;b&gt;/api/data – data.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;GET /bundle – minden adat egyben: tanulo, jegyek, orarend, mulasztasok,&lt;br&gt;   hazi, szamonkeres, feljegyzesek (force=1: frissítés, legfeljebb percenként)&lt;br&gt;GET /&amp;lt;what&amp;gt; – egy adatfajta, dátumszűréssel (pl. heti órarend)&lt;br&gt;válaszban: changed, wait, cooldown, stale – a frontend ebből tudja, mikor kérhet újra&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 3"><mxGeometry x="20" y="265" width="960" height="165" as="geometry"/></mxCell><mxCell id="2. 6" value="&lt;b&gt;/api/prefs – prefs.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;GET / PUT – téma, színek, saját tantárgy- és tanárnevek, kezdőoldal, tervező, táska&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 3"><mxGeometry x="20" y="445" width="960" height="80" as="geometry"/></mxCell><mxCell id="2. 7" value="&lt;b&gt;/api/site – site.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;GET – közlemény, karbantartás, teszt fiók és visszajelzés be/ki&lt;br&gt;GET/PUT /admin – fejlesztői oldal (admin e-mail)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 3"><mxGeometry x="20" y="540" width="960" height="95" as="geometry"/></mxCell><mxCell id="2. 8" value="&lt;b&gt;/api/feedback · /api/contact&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;POST /api/feedback – hiba (GlitchTip+Discord), ötlet, üzenet (Discord)&lt;br&gt;GET /api/contact/discord – a Discord-szerver élő adatai&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 3"><mxGeometry x="20" y="650" width="960" height="95" as="geometry"/></mxCell><mxCell id="2. 9" value="Belső modulok" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="780" height="560" as="geometry"/></mxCell><mxCell id="2. 10" value="&lt;b&gt;kreta.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;new_pkce, authorize_url, scripted_login (űrlapkitöltés)&lt;br&gt;exchange_code, login_with_password, save_user&lt;br&gt;_refresh / _access: token megújítás, felhasználónkénti zár&lt;br&gt;lekérés: MIN_GAP szünet, 429 után cooldown, gyorsítótár&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 9"><mxGeometry x="20" y="50" width="740" height="102" as="geometry"/></mxCell><mxCell id="2. 11" value="&lt;b&gt;security.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Fernet titkosítás (enc/dec), jelszó-hash (e-mailes fiók)&lt;br&gt;munkamenet: kp_sid süti, sid hash az adatbázisban&lt;br&gt;login_required, admin_required, csrf_check&lt;br&gt;too_many_attempts / record_attempt (korlátok)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 9"><mxGeometry x="20" y="164" width="740" height="102" as="geometry"/></mxCell><mxCell id="2. 12" value="&lt;b&gt;demo.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;kitalált, felhasználónként stabil diákadatok,&lt;br&gt;a KRÉTA válaszaival azonos szerkezetben&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 9"><mxGeometry x="20" y="278" width="740" height="66" as="geometry"/></mxCell><mxCell id="2. 13" value="&lt;b&gt;site.py · discord.py · monitoring.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;oldalbeállítások · webhook-küldés · GlitchTip (adatvédelmi szűrés)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 9"><mxGeometry x="20" y="356" width="740" height="48" as="geometry"/></mxCell><mxCell id="2. 14" value="&lt;b&gt;config.py · db.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;környezeti változók (KP_*), CACHE_TTL, ENDPOINTS&lt;br&gt;SQLite kapcsolat szálanként, WAL mód&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 9"><mxGeometry x="20" y="416" width="740" height="66" as="geometry"/></mxCell><mxCell id="2. 15" value="SQLite táblák – data/zsirkreta.db" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D4F7E8;swimlaneFillColor=#FFFFFF;strokeColor=#17A06A;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1080" y="710" width="780" height="230" as="geometry"/></mxCell><mxCell id="2. 16" value="&lt;b&gt;users&lt;/b&gt;: KRÉTA-azonosító, titkosított refresh/access token, név, e-mail, admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=11;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 15"><mxGeometry x="20" y="50" width="365" height="50" as="geometry"/></mxCell><mxCell id="2. 17" value="&lt;b&gt;sessions&lt;/b&gt;: sid hash, lejárat, eszköz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=11;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 15"><mxGeometry x="395" y="50" width="365" height="50" as="geometry"/></mxCell><mxCell id="2. 18" value="&lt;b&gt;cache&lt;/b&gt;: user_id + kulcs → KRÉTA-válasz, lekérés ideje" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=11;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 15"><mxGeometry x="20" y="108" width="365" height="50" as="geometry"/></mxCell><mxCell id="2. 19" value="&lt;b&gt;prefs&lt;/b&gt;: beállítások JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=11;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 15"><mxGeometry x="395" y="108" width="365" height="50" as="geometry"/></mxCell><mxCell id="2. 20" value="&lt;b&gt;attempts&lt;/b&gt;: belépési és küldési próbák (korlát)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=11;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 15"><mxGeometry x="20" y="166" width="365" height="50" as="geometry"/></mxCell><mxCell id="2. 21" value="&lt;b&gt;site&lt;/b&gt;: közlemény, kapcsolók" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=11;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 15"><mxGeometry x="395" y="166" width="365" height="50" as="geometry"/></mxCell><mxCell id="2. 22" value="KRÉTA felé (Ellenőrző API, a config.ENDPOINTS szerint)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFD6E8;swimlaneFillColor=#FFFFFF;strokeColor=#D63A80;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1820" height="240" as="geometry"/></mxCell><mxCell id="2. 23" value="&lt;b&gt;tanulo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/TanuloAdatlap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="20" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 24" value="&lt;b&gt;jegyek&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/Ertekelesek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="275" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 25" value="&lt;b&gt;orarend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/OrarendElemek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="530" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 26" value="&lt;b&gt;mulasztasok&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/Mulasztasok&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="785" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 27" value="&lt;b&gt;hazi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/HaziFeladatok&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="1040" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 28" value="&lt;b&gt;szamonkeres&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/BejelentettSzamonkeresek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="1295" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 29" value="&lt;b&gt;feljegyzesek&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sajat/Feljegyzesek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="2. 22"><mxGeometry x="1550" y="50" width="240" height="70" as="geometry"/></mxCell><mxCell id="2. 30" value="Udvarias lekérés: minden válasz a cache táblába kerül adatfajtánként eltérő élettartammal (CACHE_TTL); a Frissítés gomb és a percenkénti automatikus frissítés felhasználónként legfeljebb FORCE_MIN_AGE (60 mp) mp-enként kér újra; 429/403 után cooldown, közben a tárolt adatot adja (stale). A belépés a KRÉTA IdP-n át megy (kreta-ellenorzo-student-mobile-ios kliens, PKCE), a jelszót a program nem tárolja." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="2. 22"><mxGeometry x="20" y="135" width="1780" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3. Tanár" name="3. Tanári backend"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3. 1" value="&lt;b&gt;Tanári backend – tanar/kreta_tanar/ (Flask, 3100)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="3. 2" value="Rétegek: blueprintek (HTTP) → ops.py (írások) / data.py (olvasások) → szolgáltató (providers.for_user: teszt fióknál DemoProvider, valódinál KretaProvider) → kreta_client.py (HTTP a KRÉTA felé) → SQLite. Minden írás előnézet → jóváhagyás → végrehajtás → visszaolvasás → napló úton megy." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell><mxCell id="3. 3" value="Blueprintek (HTTP API)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="600" height="785" as="geometry"/></mxCell><mxCell id="3. 4" value="&lt;b&gt;/api/auth – auth.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;GET /info – mi érhető el (teszt fiók, KRÉTA, linkes belépés, visszajelzés)&lt;br&gt;GET /link/start → POST /link/finish – KRÉTA-oldali belépés (PKCE, beillesztett cím)&lt;br&gt;POST /login – jelszavas (űrlapkitöltés, tartalék: password grant)&lt;br&gt;csak „Tanar” szerepkör · POST /demo · GET /me · /logout · /account/delete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 3"><mxGeometry x="20" y="50" width="560" height="150" as="geometry"/></mxCell><mxCell id="3. 5" value="&lt;b&gt;/api/t – data.py (olvasás)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;GET /overview – tanár, csoportok, osztályok, engedélyezett műveletek&lt;br&gt;GET /lessons?from&amp;to · /attendance?groupId&amp;date&amp;nr&lt;br&gt;GET /group/&amp;lt;id&amp;gt; · /class/&amp;lt;id&amp;gt; · /student/&amp;lt;id&amp;gt;&lt;br&gt;GET /homework · /tests · /notes · /log (műveletnapló)&lt;br&gt;POST /refresh – kézi frissítés (30 mp-enként)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 3"><mxGeometry x="20" y="215" width="560" height="165" as="geometry"/></mxCell><mxCell id="3. 6" value="&lt;b&gt;/api/ops – ops.py (írás)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;POST /preview – ellenőrzés + előnézet + a pontos KRÉTA-kérés + egyszeri token&lt;br&gt;POST /commit – token beváltása → apply → verify → audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 3"><mxGeometry x="20" y="395" width="560" height="95" as="geometry"/></mxCell><mxCell id="3. 7" value="&lt;b&gt;/api/prefs · /api/feedback&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;beállítások · hiba / ötlet → GlitchTip „Tanári” projekt (+ Discord, ha van)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 3"><mxGeometry x="20" y="505" width="560" height="80" as="geometry"/></mxCell><mxCell id="3. 8" value="Műveletek: lesson.log (téma + mulasztás), lesson.topic, grade.add / edit / delete, homework.add / delete, test.add / delete, absence.record és note.add / delete (csak teszt fiókban). Éles írás alapból BE; KT_LIVE_WRITE=0 vagy KT_LIVE_OPS szűkíti." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="3. 3"><mxGeometry x="20" y="605" width="560" height="160" as="geometry"/></mxCell><mxCell id="3. 9" value="ops.py – írási réteg" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFE3C4;swimlaneFillColor=#FFFFFF;strokeColor=#D9791C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="560" height="470" as="geometry"/></mxCell><mxCell id="3. 10" value="&lt;b&gt;1. validátor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;megtisztítja az adatot, emberi nyelvű sorokat ad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 9"><mxGeometry x="20" y="50" width="520" height="60" as="geometry"/></mxCell><mxCell id="3. 11" value="&lt;b&gt;2. describe()&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;a szolgáltató megírja a pontos KRÉTA-kérést (módszer, útvonal, JSON)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 9"><mxGeometry x="20" y="125" width="520" height="60" as="geometry"/></mxCell><mxCell id="3. 12" value="&lt;b&gt;3. pending_ops&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;egyszer használható token, 10 percig érvényes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 9"><mxGeometry x="20" y="200" width="520" height="60" as="geometry"/></mxCell><mxCell id="3. 13" value="&lt;b&gt;4. commit → apply()&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;csak ha enabled(op); újrapróbálás nincs; utána gyorsítótár ürítése&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 9"><mxGeometry x="20" y="275" width="520" height="60" as="geometry"/></mxCell><mxCell id="3. 14" value="&lt;b&gt;5. verify() → audit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;visszaolvasás a KRÉTA-ból · ok / unverified / error a műveletnaplóba&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 9"><mxGeometry x="20" y="350" width="520" height="60" as="geometry"/></mxCell><mxCell id="3. 15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3. 10" target="3. 11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3. 11" target="3. 12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3. 12" target="3. 13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="3. 13" target="3. 14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 19" value="providers/ – szolgáltatók" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="580" height="760" as="geometry"/></mxCell><mxCell id="3. 20" value="&lt;b&gt;base.py – Provider&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;közös adatforma: groups, classes, students, grades,&lt;br&gt;lessons, absences, homework, tests, notes&lt;br&gt;capabilities() · enabled(op) · describe · apply · verify&lt;br&gt;GRADE_TYPES, TEST_KINDS, NOTE_KINDS, BELLS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 19"><mxGeometry x="20" y="50" width="540" height="120" as="geometry"/></mxCell><mxCell id="3. 21" value="&lt;b&gt;demo.py – DemoProvider (teszt fiók)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;generate(): 3 osztály, 5 csoport, ~75 diák, órarend,&lt;br&gt;jegyek, mulasztások, házik, napló, feljegyzések&lt;br&gt;a demo_state táblában (JSON), minden művelet szimulált&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 19"><mxGeometry x="20" y="190" width="540" height="120" as="geometry"/></mxCell><mxCell id="3. 22" value="&lt;b&gt;kreta.py – KretaProvider (valódi KRÉTA)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;csoport = OsztalyCsoportId-TantargyId (Tantargyfelosztas + órarend)&lt;br&gt;órarend hetenként (hétfő–vasárnap), ablak: −14…+35 nap&lt;br&gt;óra állapota: Allapot 1 naplózott · 2 nem · 3 elmaradt · 4 tanév rendje&lt;br&gt;   (a Naplozart = a napló le van zárva)&lt;br&gt;jelenlét-kódok: 1498 jelen · 1499 késik · 1500 hiányzik&lt;br&gt;értékelési módok: ErtekelesModEnum, tartalék 1507–1516&lt;br&gt;osztályzat: 1500 + érték (1501–1505)&lt;br&gt;írás: lesson.log → Orarend/OraNaplozas&lt;br&gt;   grade.add → OsztalyCsoport/Ertekeles (V3 modell)&lt;br&gt;   grade.edit/delete → …/Tanulok/Ertekeles/{id}&lt;br&gt;   homework → HaziFeladat · test → BejelentettSzamonkeres&lt;br&gt;verify: naplózásnál állapot + téma + minden diák jelenléte&lt;br&gt;PROVEN = {lesson.log, lesson.topic}: nem kér kézi ellenőrzést&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 19"><mxGeometry x="20" y="330" width="540" height="410" as="geometry"/></mxCell><mxCell id="3. 23" value="kreta_client.py – KRÉTA-kliens" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="680" y="630" width="560" height="250" as="geometry"/></mxCell><mxCell id="3. 24" value="&lt;b&gt;belépés és lekérés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;new_pkce · authorize_url · exchange_code · check_teacher&lt;br&gt;_refresh / _access: token megújítás (kreta-naplo-mobile-ios)&lt;br&gt;_call: felhasználónkénti zár, MIN_GAP szünet, 401 → új token, 429/403 → cooldown&lt;br&gt;get(): gyorsítótár (útvonalanként TTL), Adatcsomag kicsomagolás, régi adat hibánál&lt;br&gt;send(): írás, Exception mező figyelése · invalidate() · refresh()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 23"><mxGeometry x="20" y="50" width="520" height="180" as="geometry"/></mxCell><mxCell id="3. 25" value="SQLite táblák – tanar/data/kreta_tanar.db" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D4F7E8;swimlaneFillColor=#FFFFFF;strokeColor=#17A06A;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1200" height="220" as="geometry"/></mxCell><mxCell id="3. 26" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;inst:sub, titkosított tokenek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="20" y="50" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 27" value="&lt;b&gt;sessions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;kt_sid süti hash, 30 nap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="312" y="50" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 28" value="&lt;b&gt;prefs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;beállítások JSON&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="604" y="50" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 29" value="&lt;b&gt;attempts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;belépés, bejelentés korlát&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="896" y="50" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 30" value="&lt;b&gt;cache&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;KRÉTA-válaszok, fetched_at&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="20" y="130" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 31" value="&lt;b&gt;demo_state&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;a teszt iskola JSON-ja&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="312" y="130" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 32" value="&lt;b&gt;pending_ops&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;jóváhagyásra váró írás + kérés&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="604" y="130" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 33" value="&lt;b&gt;audit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;műveletnapló: ok / unverified / error&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4F7E8;strokeColor=#17A06A;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="3. 25"><mxGeometry x="896" y="130" width="280" height="68" as="geometry"/></mxCell><mxCell id="3. 34" value="KRÉTA Napló API V3 – {iskola}.e-kreta.hu/naplo/V3/" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFD6E8;swimlaneFillColor=#FFFFFF;strokeColor=#D63A80;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1280" y="920" width="580" height="220" as="geometry"/></mxCell><mxCell id="3. 35" value="&lt;b&gt;olvasás:&lt;/b&gt; Tanar/Profil, Tanar/Tantargyfelosztas, Orarend?datumTol&amp;amp;datumIg, Orarend/OrarendElem, Orarend/Jelenlet, OsztalyCsoport/Tanulok, …/Tanulok/Ertekeles, OsztalyCsoport/Ertekeles, Enum/NaploEnum (csak ErtekelesModEnum), HaziFeladat/{id}&lt;br&gt;&lt;b&gt;írás:&lt;/b&gt; POST Orarend/OraNaplozas, POST HaziFeladat, POST Orarend/BejelentettSzamonkeres, POST OsztalyCsoport/Ertekeles, PUT/DELETE OsztalyCsoport/Tanulok/Ertekeles/{id}, DELETE HaziFeladat/{id}, DELETE Orarend/BejelentettSzamonkeres/{id}" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="3. 34"><mxGeometry x="20" y="45" width="540" height="170" as="geometry"/></mxCell><mxCell id="3. 36" value="Egyéb modulok: security.py (Fernet, munkamenet, CSRF, korlátok) · config.py (KT_* változók: KT_DATA, KT_LIVE_WRITE, KT_LIVE_OPS, KT_GLITCHTIP_DSN, KT_DISCORD_WEBHOOK, KT_DEMO, KT_KRETA …) · monitoring.py (GlitchTip, a kérés törzse és a diákazonosítók nélkül) · discord.py (webhook) · db.py (SQLite, WAL)." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="1820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4. Front" name="4. Frontendek"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4. 1" value="&lt;b&gt;Frontendek – vanilla JavaScript, build nélkül&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="4. 2" value="Mindkét felület egy index.html, ES modulokkal; a nézetek lusta betöltéssel (import()) jönnek. Útvonal: #nézet vagy #nézet/paraméter. Minden kérés az api.js-en megy: JSON, süti, X-KP: 1 fejléc; 401 esetén „kp:auth” esemény → belépőoldal. CSP: csak saját forrás, betűtípusok helyben." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell><mxCell id="4. 3" value="Diák felület – public/" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFF4B8;swimlaneFillColor=#FFFFFF;strokeColor=#C9A800;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="880" height="1000" as="geometry"/></mxCell><mxCell id="4. 4" value="&lt;b&gt;main.js&lt;/b&gt; – VIEWS, csoportos oldalsáv, alsó menü telefonon, frissítés (percenként + gomb), értesítések, csendes újrarajzolás" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="50" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 5" value="&lt;b&gt;state.js&lt;/b&gt; – S: bundle adatai, beállítások, hibák; témák és színek alkalmazása" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="110" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 6" value="&lt;b&gt;api.js · util.js&lt;/b&gt; – fetch + hibakezelés · dátumok, átlag, színkódok, toast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="170" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 7" value="&lt;b&gt;charts.js · story.js&lt;/b&gt; – 11 grafikon (SVG) · Story kép (canvas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="230" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 8" value="&lt;b&gt;bugreport.js · funny.js · transition.js&lt;/b&gt; – hiba/ötlet/üzenet űrlap · vicces szövegek · oldalváltás" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="290" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 9" value="&lt;b&gt;views/&lt;/b&gt; (menücsoportok)" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="4. 3"><mxGeometry x="20" y="355" width="840" height="30" as="geometry"/></mxCell><mxCell id="4. 10" value="&lt;b&gt;dashboard.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Kezdőlap: 4 szám, mai órák, friss jegyek, házik&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="395" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 11" value="&lt;b&gt;grades.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Jegyek + jegyszámoló, félévszűrés&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="395" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 12" value="&lt;b&gt;stats.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Statisztika, Story kép&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="457" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 13" value="&lt;b&gt;absences.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Hiányzások, igazolás állapota&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="457" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 14" value="&lt;b&gt;notes.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Feljegyzések&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="519" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 15" value="&lt;b&gt;timetable.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Heti órarend, helyettesítés&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="519" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 16" value="&lt;b&gt;homework.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Házi és számonkérés, kipipálás&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="581" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 17" value="&lt;b&gt;planner.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Tervező: saját házi, dolgozat&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="581" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 18" value="&lt;b&gt;pack.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Táska: mit vigyél holnap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="643" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 19" value="&lt;b&gt;names.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Saját tantárgy- és tanárnevek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="643" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 20" value="&lt;b&gt;settings.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Megjelenés, fiók, munkamenetek&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="705" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 21" value="&lt;b&gt;contact.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Kapcsolatok, Discord, üzenet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="705" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 22" value="&lt;b&gt;dev.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Fejlesztő: közlemény, kapcsolók&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="20" y="767" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 23" value="&lt;b&gt;login.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Belépés: KRÉTA-oldal, beillesztés, teszt fiók&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 3"><mxGeometry x="445" y="767" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 24" value="Tanári felület – tanar/public/" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFF4B8;swimlaneFillColor=#FFFFFF;strokeColor=#C9A800;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="880" height="1000" as="geometry"/></mxCell><mxCell id="4. 25" value="&lt;b&gt;main.js&lt;/b&gt; – VIEWS + rejtett „lesson” nézet, csoportos menü, kézi frissítés, hiba/ötlet gomb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="50" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 26" value="&lt;b&gt;state.js&lt;/b&gt; – S.ov (áttekintés), beállítások, gradeTypes / testKinds / enabled(op)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="110" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 27" value="&lt;b&gt;ops.js&lt;/b&gt; – runOp(): előnézet → megerősítő ablak (kérés, figyelmeztetés) → commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="170" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 28" value="&lt;b&gt;api.js · util.js&lt;/b&gt; – fetch + X-KP · dátumok, jegyszínek, csengetési rend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="230" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 29" value="&lt;b&gt;bugreport.js&lt;/b&gt; – hiba / ötlet űrlap a GlitchTip „Tanári” projekthez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="290" width="840" height="50" as="geometry"/></mxCell><mxCell id="4. 30" value="&lt;b&gt;views/&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="4. 24"><mxGeometry x="20" y="355" width="840" height="30" as="geometry"/></mxCell><mxCell id="4. 31" value="&lt;b&gt;dashboard.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Kezdőlap: mai órák, beírandók, számonkérések, lemaradók&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="395" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 32" value="&lt;b&gt;timetable.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Heti órarend, kattintható órák&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="445" y="395" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 33" value="&lt;b&gt;lesson.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Az óra oldala: Naplózás + Jegyek fül&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="457" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 34" value="&lt;b&gt;attendance.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Mulasztás: névsor, téma, egy mentés&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="445" y="457" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 35" value="&lt;b&gt;journal.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Haladási napló: témák hetenként&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="519" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 36" value="&lt;b&gt;gradebook.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Jegynapló: gyors beírás, módosítás&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="445" y="519" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 37" value="&lt;b&gt;homework.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Házi kiadása, törlése&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="581" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 38" value="&lt;b&gt;tests.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Számonkérés bejelentése&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="445" y="581" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 39" value="&lt;b&gt;classes.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Osztályok, diák adatlap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="643" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 40" value="&lt;b&gt;notes.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Feljegyzés, dicséret (teszt fiók)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="445" y="643" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 41" value="&lt;b&gt;log.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Műveletnapló&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="705" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 42" value="&lt;b&gt;settings.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Megjelenés, KRÉTA-állapot műveletenként&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="445" y="705" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 43" value="&lt;b&gt;login.js&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;KRÉTA-oldali / jelszavas belépés, teszt fiók&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#C9A800;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="4. 24"><mxGeometry x="20" y="767" width="415" height="54" as="geometry"/></mxCell><mxCell id="4. 44" value="Közös dizájn: css/app.css („Kiemelő az íróasztalon”: sötét dió háttér, kiemelő színek, URW Gothic betű), a tanári felületen kiegészítve a css/tanar.css-sel (jegynapló, névsor, megerősítő ablak). Témák: sötét / AMOLED / világos, 12 színpaletta, saját kiemelőszín." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1820" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5. Folya" name="5. Folyamatok"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5. 1" value="&lt;b&gt;Fő folyamatok lépésről lépésre&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="5. 2" value="A) Belépés a KRÉTA saját oldalán (diák és tanár egyformán)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFE3C4;swimlaneFillColor=#FFFFFF;strokeColor=#D9791C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1820" height="220" as="geometry"/></mxCell><mxCell id="5. 3" value="&lt;b&gt;1. Gomb&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;„Belépés a KRÉTA-ban”: GET /api/auth/link/start&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="20" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 4" value="&lt;b&gt;2. PKCE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;a szerver verifier + challenge-t készít, a verifier a memóriában, süti: pid&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="246" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 5" value="&lt;b&gt;3. KRÉTA belépőoldal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;új lapon idp.e-kreta.hu /connect/authorize, a felhasználó ott lép be&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="472" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 6" value="&lt;b&gt;4. Átirányítás&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;…/oauthredirect?code=… (hibaoldal vagy üres lap)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="698" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 7" value="&lt;b&gt;5. Beillesztés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;a felület visszatéréskor kiolvassa a vágólapot, vagy beillesztik&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="924" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 8" value="&lt;b&gt;6. link/finish&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;kód + verifier → /connect/token (access + refresh)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="1150" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 9" value="&lt;b&gt;7. Ellenőrzés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;tanárnál „Tanar” szerepkör, iskolakód a tokenből&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="1376" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 10" value="&lt;b&gt;8. Munkamenet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;titkosított token a users táblába, süti a böngészőbe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 2"><mxGeometry x="1602" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 3" target="5. 4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 4" target="5. 5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 5" target="5. 6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 6" target="5. 7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 7" target="5. 8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 8" target="5. 9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 9" target="5. 10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 18" value="B) Olvasás és frissítés (udvarias lekérés)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#D6F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1820" height="220" as="geometry"/></mxCell><mxCell id="5. 19" value="&lt;b&gt;1. Nézet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;pl. órarend: api.js GET /api/… (diák: /api/data/bundle)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="20" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 20" value="&lt;b&gt;2. Szolgáltató&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;tanár: providers.for_user → Demo vagy Kreta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="246" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 21" value="&lt;b&gt;3. Gyorsítótár&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;cache tábla: friss? → azonnal válasz&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="472" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 22" value="&lt;b&gt;4. KRÉTA-hívás&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;felhasználónkénti zár, szünet, token megújítás&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="698" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 23" value="&lt;b&gt;5. Hiba esetén&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;429/403 → cooldown, a régi adat megy (stale)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="924" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 24" value="&lt;b&gt;6. Mentés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;válasz a cache-be, átalakítás közös formára&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="1150" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 25" value="&lt;b&gt;7. Frissítés gomb&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;diák: legfeljebb percenként · tanár: 30 mp-enként&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="1376" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 26" value="&lt;b&gt;8. Újrarajzolás&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;az aktuális oldal csendben frissül&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F0FF;strokeColor=#2A8BC4;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 18"><mxGeometry x="1602" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 19" target="5. 20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 20" target="5. 21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 21" target="5. 22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 22" target="5. 23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 23" target="5. 24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 24" target="5. 25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 25" target="5. 26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 34" value="C) Írás a KRÉTA-ba (tanári felület)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFE3C4;swimlaneFillColor=#FFFFFF;strokeColor=#D9791C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1820" height="220" as="geometry"/></mxCell><mxCell id="5. 35" value="&lt;b&gt;1. Művelet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;pl. naplózás az óra oldalán: runOp('lesson.log', …)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="20" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 36" value="&lt;b&gt;2. Előnézet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;POST /api/ops/preview: validálás, emberi nyelvű sorok&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="246" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 37" value="&lt;b&gt;3. KRÉTA-kérés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;describe(): a pontos módszer, útvonal, JSON&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="472" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 38" value="&lt;b&gt;4. Megerősítés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;ablak: mi kerül be, figyelmeztetés, „Kérés” lenyitható&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="698" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 39" value="&lt;b&gt;5. Commit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;POST /api/ops/commit: a token egyszer váltható be&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="924" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 40" value="&lt;b&gt;6. apply()&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;küldés a KRÉTA-nak újrapróbálás nélkül, cache ürítése&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="1150" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 41" value="&lt;b&gt;7. verify()&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;visszaolvasás: állapot, téma, jelenlét / jegy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="1376" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 42" value="&lt;b&gt;8. Napló&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;audit: ok / nem megerősített / hiba → „Kész” vagy figyelmeztetés&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 34"><mxGeometry x="1602" y="50" width="200" height="150" as="geometry"/></mxCell><mxCell id="5. 43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 35" target="5. 36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 36" target="5. 37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 37" target="5. 38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 38" target="5. 39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 39" target="5. 40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 40" target="5. 41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 41" target="5. 42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 50" value="D) Hiba / ötlet bejelentése" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFD6E8;swimlaneFillColor=#FFFFFF;strokeColor=#D63A80;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1820" height="220" as="geometry"/></mxCell><mxCell id="5. 51" value="&lt;b&gt;1. Gomb&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;„📣 Hiba / ötlet”, vagy hibás oldalon „🐞 Hiba bejelentése”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 50"><mxGeometry x="20" y="50" width="270" height="150" as="geometry"/></mxCell><mxCell id="5. 52" value="&lt;b&gt;2. Űrlap&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;fajta, szöveg, elérhetőség, technikai adatok (opcionális)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 50"><mxGeometry x="320" y="50" width="270" height="150" as="geometry"/></mxCell><mxCell id="5. 53" value="&lt;b&gt;3. POST /api/feedback&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;IP-nként óránként 5, legalább 5 karakter&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 50"><mxGeometry x="620" y="50" width="270" height="150" as="geometry"/></mxCell><mxCell id="5. 54" value="&lt;b&gt;4. GlitchTip&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;esemény saját ujjlenyomattal, címkék: kind, view, demo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 50"><mxGeometry x="920" y="50" width="270" height="150" as="geometry"/></mxCell><mxCell id="5. 55" value="&lt;b&gt;5. Discord&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;ha van webhook: értesítés link a GlitchTip-eseményre&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 50"><mxGeometry x="1220" y="50" width="270" height="150" as="geometry"/></mxCell><mxCell id="5. 56" value="&lt;b&gt;6. Köszönet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;toast a felületen&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD6E8;strokeColor=#D63A80;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 50"><mxGeometry x="1520" y="50" width="270" height="150" as="geometry"/></mxCell><mxCell id="5. 57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 51" target="5. 52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 52" target="5. 53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 53" target="5. 54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 54" target="5. 55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 55" target="5. 56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 62" value="E) Teszt fiók (belépés nélkül)" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#F2EEE9;swimlaneFillColor=#FFFFFF;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1820" height="220" as="geometry"/></mxCell><mxCell id="5. 63" value="&lt;b&gt;1. Gomb&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;„Kipróbálom teszt fiókkal”: POST /api/auth/demo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 62"><mxGeometry x="20" y="50" width="330" height="150" as="geometry"/></mxCell><mxCell id="5. 64" value="&lt;b&gt;2. Új felhasználó&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;inst = demo, 7 nap után törlődik&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 62"><mxGeometry x="380" y="50" width="330" height="150" as="geometry"/></mxCell><mxCell id="5. 65" value="&lt;b&gt;3. Adatok&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;diák: demo.py · tanár: DemoProvider.generate()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 62"><mxGeometry x="740" y="50" width="330" height="150" as="geometry"/></mxCell><mxCell id="5. 66" value="&lt;b&gt;4. Ugyanaz a felület&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;minden nézet és művelet használható&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 62"><mxGeometry x="1100" y="50" width="330" height="150" as="geometry"/></mxCell><mxCell id="5. 67" value="&lt;b&gt;5. Szimulált írás&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;tanárnál a demo_state változik, a KRÉTA-ba semmi nem megy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="5. 62"><mxGeometry x="1460" y="50" width="330" height="150" as="geometry"/></mxCell><mxCell id="5. 68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 63" target="5. 64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 64" target="5. 65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 65" target="5. 66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5. 71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="5. 66" target="5. 67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="6. Telep" name="6. Telepítés"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6. 1" value="&lt;b&gt;Telepítés és futtatás&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontColor=#1D1510;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="6. 2" value="Dockerfile – egy fájl, két kép" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFE3C4;swimlaneFillColor=#FFFFFF;strokeColor=#D9791C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="860" height="560" as="geometry"/></mxCell><mxCell id="6. 3" value="&lt;b&gt;base (python:3.14-slim)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;pip install -r requirements.txt + gunicorn (Flask, requests, cryptography, sentry-sdk)&lt;br&gt;app felhasználó (uid 1000), /data kötet&lt;br&gt;HEALTHCHECK: GET /api/health 30 mp-enként&lt;br&gt;TZ=Europe/Budapest&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 2"><mxGeometry x="20" y="50" width="820" height="150" as="geometry"/></mxCell><mxCell id="6. 4" value="&lt;b&gt;diak → zsirkreta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;COPY zsirkreta/ + public/&lt;br&gt;KP_DATA=/data · KP_ENV=production&lt;br&gt;gunicorn 0.0.0.0:3000&lt;br&gt;1 worker × 8 szál (a linkes belépés&lt;br&gt;állapota a memóriában van)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 2"><mxGeometry x="20" y="240" width="395" height="200" as="geometry"/></mxCell><mxCell id="6. 5" value="&lt;b&gt;tanar → zsirkreta-tanar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;COPY tanar/kreta_tanar/ + tanar/public/&lt;br&gt;KT_DATA=/data&lt;br&gt;gunicorn 0.0.0.0:3100&lt;br&gt;1 worker × 8 szál, timeout 120&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 2"><mxGeometry x="445" y="240" width="395" height="200" as="geometry"/></mxCell><mxCell id="6. 6" value=".dockerignore: .venv, data, tanar/data, landerpage, docs, .env … nem kerül a képbe.&lt;br&gt;Build: docker compose build (diák) · docker compose build tanar" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5A4A3E;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="6. 2"><mxGeometry x="20" y="460" width="820" height="80" as="geometry"/></mxCell><mxCell id="6. 7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="6. 3" target="6. 4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6. 8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B5B4E;strokeWidth=1.6;fontColor=#1D1510;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="6. 3" target="6. 5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6. 9" value="docker-compose.yml" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#FFE3C4;swimlaneFillColor=#FFFFFF;strokeColor=#D9791C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="900" height="560" as="geometry"/></mxCell><mxCell id="6. 10" value="&lt;b&gt;szolgáltatás: zsirkreta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;port 127.0.0.1:3000 → HTTPS-es proxy (nginx, Caddy) mögé&lt;br&gt;KP_ENV, KP_TRUST_PROXY=1 (valódi IP, Secure süti)&lt;br&gt;titkok a .env-ből: KP_DISCORD_WEBHOOK, KP_DEV_CODE&lt;br&gt;opcionális: KP_GLITCHTIP_DSN, KP_DEMO, KP_DISCORD_INVITE&lt;br&gt;kötet: zsirkreta-data → /data&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 9"><mxGeometry x="20" y="50" width="860" height="220" as="geometry"/></mxCell><mxCell id="6. 11" value="&lt;b&gt;szolgáltatás: tanar (profiles: tanar – csak kérésre indul)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;port 127.0.0.1:3100 – csak a saját gépről, internetre ne&lt;br&gt;KT_ENV=production · KT_DISCORD_WEBHOOK a .env-ből&lt;br&gt;opcionális: KT_GLITCHTIP_DSN, KT_FEEDBACK, KT_LIVE_WRITE, KT_LIVE_OPS, KT_DEMO, KT_KRETA&lt;br&gt;kötet: zsirkreta-tanar-data → /data&lt;br&gt;indítás: docker compose --profile tanar up -d tanar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3C4;strokeColor=#D9791C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 9"><mxGeometry x="20" y="290" width="860" height="250" as="geometry"/></mxCell><mxCell id="6. 12" value="Helyi fejlesztés és tesztelés" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#F2EEE9;swimlaneFillColor=#FFFFFF;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=15;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1820" height="300" as="geometry"/></mxCell><mxCell id="6. 13" value="&lt;b&gt;Indítás konténer nélkül&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;uv run run.py → diák, http://localhost:3000&lt;br&gt;uv run tanar/run.py → tanár, http://127.0.0.1:3100&lt;br&gt;az adatok: data/ és tanar/data/ (SQLite + secret.key)&lt;br&gt;KT_LIVE_WRITE=0 → a tanári írás csak előnézet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 12"><mxGeometry x="20" y="50" width="580" height="220" as="geometry"/></mxCell><mxCell id="6. 14" value="&lt;b&gt;Ellenőrzés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;/api/health – egészség&lt;br&gt;teszt fiók: kitalált adatok, minden funkció kipróbálható&lt;br&gt;[KRÉTA] sorok a szerver kimenetén: minden hívás és hiba&lt;br&gt;Műveletnapló: minden tanári írás eredménye&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 12"><mxGeometry x="620" y="50" width="580" height="220" as="geometry"/></mxCell><mxCell id="6. 15" value="&lt;b&gt;Hibakövetés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;GlitchTip: szerverhibák maguktól, bejelentések kézzel&lt;br&gt;KT_ENV / KP_ENV=development a próbákhoz&lt;br&gt;adatvédelem: a kérés törzse, sütik, tokenek,&lt;br&gt;diákazonosítók nem kerülnek a jelentésbe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEE9;strokeColor=#8A7A6C;fontColor=#1D1510;fontSize=12;align=left;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="6. 12"><mxGeometry x="1220" y="50" width="580" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
